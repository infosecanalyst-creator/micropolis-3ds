# Desktop test build: renders frames to PPM files (no SDL needed).
CXX ?= g++
CXXFLAGS ?= -O2 -std=c++11 -w -Iengine -Isrc
ENGINE_SRC := $(wildcard engine/*.cpp)
APP_SRC := src/app.cpp src/headless/platform_headless.cpp
OBJ := $(ENGINE_SRC:.cpp=.o) $(APP_SRC:.cpp=.o)

micropolis-headless: $(OBJ)
	$(CXX) $(CXXFLAGS) -o $@ $(OBJ)

%.o: %.cpp
	$(CXX) $(CXXFLAGS) -c $< -o $@

clean:
	rm -f $(OBJ) micropolis-headless
